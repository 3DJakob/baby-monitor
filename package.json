{
  "name": "homebridge-baby-monitor-local",
  "version": "0.1.1",
  "description": "A simple Homebridge plugin that hosts a local baby monitor WebRTC page.",
  "main": "index.js",
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "webrtc",
    "baby-monitor",
    "raspberry-pi"
  ],
  "engines": {
    "homebridge": "^1.8.0",
    "node": ">=18.0.0"
  },
  "homepage": "https://github.com/3DJakob/baby-monitor",
  "license": "MIT",
  "author": "Jakob Unnebäck",
  "files": [
    "index.js",
    "src",
    "public",
    "config.schema.json",
    "README.md"
  ],
  "scripts": {
    "start": "node ./index.js",
    "dev": "node --watch ./index.js",
    "lint": "node -e \"require('./index.js'); console.log('Plugin entry loaded successfully')\"",
    "test": "node --test"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
